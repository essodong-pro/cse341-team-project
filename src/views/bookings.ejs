<%- include('./partials/header') %>

    <section class="bookings-hero">
        <h1>Bookings Admin</h1>
        <p>
            Review every booking made across the Kizuna Rail network.
        </p>
    </section>

    <section class="bookings-catalog">

        <form class="bookings-filters" id="bookings-filters">
            <div class="bookings-filter-group">
                <label for="booking-ticket-class">Ticket Class</label>
                <select id="booking-ticket-class" name="ticketClass">
                    <option value="">All ticket classes</option>
                </select>
            </div>

            <div class="bookings-filter-group">
                <label for="booking-start-date">Start Date</label>
                <input type="date" id="booking-start-date" name="startDate">
            </div>

            <div class="bookings-filter-group">
                <label for="booking-end-date">End Date</label>
                <input type="date" id="booking-end-date" name="endDate">
            </div>

            <div class="bookings-filter-actions">
                <button type="submit" class="bookings-filter-button">
                    Apply Filters
                </button>

                <button type="button" class="bookings-clear-button" id="bookings-clear-filters">
                    Clear Filters
                </button>
            </div>
        </form>

        <div class="bookings-state bookings-filter-error" id="bookings-filter-error" hidden></div>

        <div class="bookings-state" id="bookings-loading">
            Loading bookings...
        </div>

        <div class="bookings-state bookings-error" id="bookings-error" hidden></div>

        <div class="bookings-grid" id="bookings-list"></div>

        <div class="bookings-pagination" id="bookings-pagination" hidden>
            <button type="button" class="bookings-pagination-button" id="bookings-previous">
                Previous
            </button>

            <span class="bookings-page-status" id="bookings-page-status">
                Page 1 of 1
            </span>

            <button type="button" class="bookings-pagination-button" id="bookings-next">
                Next
            </button>
        </div>

        <template id="booking-card-template">
            <article class="booking-card">
                <div class="booking-card-header">
                    <h2 data-field="id"></h2>

                    <div class="booking-header-meta">
                        <span class="booking-ticket-class" data-field="ticketClass"></span>

                        <span class="booking-price" data-field="totalPrice"></span>
                    </div>
                </div>

                <dl class="booking-specs">
                    <div class="spec-item">
                        <dt>Trip</dt>
                        <dd data-field="tripName"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Day</dt>
                        <dd data-field="selectedDay"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Passengers</dt>
                        <dd data-field="passengerCount"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Booked On</dt>
                        <dd data-field="createdAt"></dd>
                    </div>
                </dl>

                <a class="booking-view-link" data-field="viewLink" href="#">
                    View Details
                </a>
            </article>
        </template>

    </section>

    <%- include('./partials/footer') %>