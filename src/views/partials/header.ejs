                                    <% if (user.role==='admin' ) { %>
                                        <a href="/admin">Dashboard</a>
                                        <% } else { %>
                                            <a href="/dashboard">Dashboard</a>
                                            <% } %>
                                </li>

                                <li>
                                    <form action="/logout" method="POST">
                                        <button type="submit">Logout</button>
                                    </form>
                                </li>
                                <% } %>

                                    <li>
                                        <a href="/404">404</a>
                                    </li>

                                    <li>
